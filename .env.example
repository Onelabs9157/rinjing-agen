# Salin ke .env (tidak di-commit) lalu isi. Dibaca agen saat start DAN oleh docker compose
# (AGENT_DATA_PATH, AGENT_VERSION untuk compose; sisanya untuk agen).

# Identitas agen — satu kode per SERVER FISIK, mis. nama host Proxmox. Tidak boleh berubah
# setelah data tersimpan (folder data dicap dengan kode ini).
AGENT_NODE_CODE=NODE_SRV2

# Rahasia bersama dengan Rinjing utama, minimal 32 karakter. Buat dengan:
#   openssl rand -hex 32
AGENT_TOKEN=

# IP Rinjing utama yang boleh memanggil API agen (koma untuk lebih dari satu, CIDR boleh).
# Rinjing utama saat ini: VM onelabs 10.10.10.25
AGENT_ALLOW_FROM=10.10.10.25

# IP:port yang dibuka di VM ini (host network). Pakai IP jaringan privat VM, bukan 0.0.0.0,
# supaya tidak ikut terbuka di antarmuka lain.
AGENT_LISTEN=10.10.10.31:9100

# TLS (opsional, disarankan). Taruh berkas di ./certs → terbaca di /certs dalam container.
# AGENT_TLS_CERT=/certs/agen.crt
# AGENT_TLS_KEY=/certs/agen.key

# Unggahan ditolak (507) bila sisa disk di bawah ini.
AGENT_MIN_FREE=5GiB
# Batas satu shard (objek S3 maks 5 GiB + padding).
AGENT_MAX_SHARD=6GiB
# Sisa unggahan yang mati di tengah dihapus setelah umur ini.
AGENT_TMP_MAX_AGE=24h

# Folder data di HOST (dipakai docker-compose.yml, bukan oleh agen). Harus dimiliki uid 10001.
AGENT_DATA_PATH=/data/rinjing-agen
